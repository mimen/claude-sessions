#!/usr/bin/env bash
set -euo pipefail

PROMPT_ROOT="/tmp/ccs-new-prompts"

usage() {
  exit 64
}

validated_session_id() {
  local value="${1:-}"
  [[ "$value" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] || usage
  printf '%s' "$value"
}

prompt_path() {
  local session_id
  session_id="$(validated_session_id "${1:-}")"
  printf '%s/%s/prompt.txt' "$PROMPT_ROOT" "$session_id"
}

prepare_prompt() {
  local path directory
  path="$(prompt_path "${1:-}")"
  directory="${path%/*}"
  umask 077
  [[ ! -e "$PROMPT_ROOT" || ( -d "$PROMPT_ROOT" && ! -L "$PROMPT_ROOT" ) ]] || exit 73
  mkdir -p "$PROMPT_ROOT"
  [[ ! -e "$directory" || ( -d "$directory" && ! -L "$directory" ) ]] || exit 73
  mkdir -p "$directory"
  chmod 700 "$PROMPT_ROOT" "$directory"
  rm -f "$path"
  printf '%s\n' "$path"
}

read_prompt() {
  local path
  path="$(prompt_path "${1:-}")"
  [[ -f "$path" && ! -L "$path" ]] || exit 66
  printf '%s' "$(<"$path")"
}

cleanup_prompt() {
  local path directory
  path="$(prompt_path "${1:-}")"
  directory="${path%/*}"
  rm -f "$path"
  rmdir "$directory" 2>/dev/null || true
}

hosts='[{"name":"Milads-Mac-mini","capabilities":["always-on","headless","ssh","shared-vault"]},{"name":"Milads-M3-2","capabilities":["interactive-gui","local-user-state","browser-auth","shared-vault"]}]'
caller='{"cwd":"/Users/mimen/Programming/Repos/claude-sessions/.claude/worktrees/ccs-new-router","git":{"root":"/Users/mimen/Programming/Repos/claude-sessions/.claude/worktrees/ccs-new-router","branch":"feat/ccs-new-router","dirty":true,"gitDir":"/fixture/worktrees/ccs-new-router","commonDir":"/fixture/.git","linkedWorktree":true}}'

operation="${1:-}"
[[ -n "$operation" ]] || usage
shift

case "$operation" in
  prepare)
    [[ "${1:-}" == "--session-id" && $# -eq 2 ]] || usage
    prepare_prompt "$2"
    ;;
  route)
    [[ "${1:-}" == "--session-id" && $# -ge 2 ]] || usage
    session_id="$2"
    query="$(read_prompt "$session_id")"
    if [[ "$query" == *"remote session receipt confirmations"* || "$query" == *"Audit literal text"* ]]; then
      printf '{"request":"fixture","host":"Milads-M3-2","fresh_only":true,"default_harness":"claude-gpt","default_model":"gpt-5.6-sol","registered_hosts":%s,"caller_context":%s,"candidates":[{"key":"ccs","host":"Milads-M3-2","current_host":"Milads-M3-2","name":"CCS","aliases":["session router"],"cwd":"/Users/mimen/Programming/Repos/claude-sessions","kind":"repo","eligible_hosts":["Milads-M3-2","Milads-Mac-mini"],"preferred_host":"Milads-Mac-mini","host_capabilities":["interactive-gui","local-user-state","browser-auth","shared-vault"],"declared_default_harness":null,"declared_default_model":null,"default_harness":"claude-gpt","default_model":"gpt-5.6-sol","status":"active","host_eligible":true,"validation_error":null,"score":1,"existing_session_warnings":[]}]}\n' "$hosts" "$caller"
    elif [[ "$query" == *"authenticated browser on this laptop"* ]]; then
      printf '{"request":"fixture","host":"Milads-M3-2","fresh_only":true,"default_harness":"claude-gpt","default_model":"gpt-5.6-sol","registered_hosts":%s,"caller_context":%s,"candidates":[{"key":"auf-web","host":"Milads-M3-2","current_host":"Milads-M3-2","name":"AUF Web Platform repository","aliases":["afternoonumbrellafriends.com"],"cwd":"/Users/mimen/Programming/Repos/afternoonumbrellafriends.com","kind":"repo","eligible_hosts":["Milads-M3-2"],"preferred_host":"Milads-M3-2","host_capabilities":["interactive-gui","local-user-state","browser-auth","shared-vault"],"declared_default_harness":"claude","declared_default_model":"claude-fable-5","default_harness":"claude","default_model":"claude-fable-5","status":"active","host_eligible":true,"validation_error":null,"score":1,"existing_session_warnings":[]}]}\n' "$hosts" "$caller"
    elif [[ "$query" == *"event workflow docs and website"* ]]; then
      printf '{"request":"fixture","host":"Milads-M3-2","fresh_only":true,"default_harness":"claude-gpt","default_model":"gpt-5.6-sol","registered_hosts":%s,"caller_context":%s,"candidates":[{"key":"events","host":"Milads-M3-2","current_host":"Milads-M3-2","name":"Events workspace","aliases":["event workflow"],"cwd":"/Users/mimen/Documents/milad-vault/Workspaces/Events","kind":"workspace","eligible_hosts":["Milads-M3-2","Milads-Mac-mini"],"preferred_host":"Milads-Mac-mini","host_capabilities":["interactive-gui","local-user-state","browser-auth","shared-vault"],"default_harness":"claude-gpt","default_model":"gpt-5.6-sol","status":"active","host_eligible":true,"validation_error":null,"score":0.88,"existing_session_warnings":[]},{"key":"auf-web","host":"Milads-M3-2","current_host":"Milads-M3-2","name":"AUF Web Platform repository","aliases":["website"],"cwd":"/Users/mimen/Programming/Repos/afternoonumbrellafriends.com","kind":"repo","eligible_hosts":["Milads-M3-2"],"preferred_host":"Milads-M3-2","host_capabilities":["interactive-gui","local-user-state","browser-auth","shared-vault"],"default_harness":"claude","default_model":"claude-fable-5","status":"active","host_eligible":true,"validation_error":null,"score":0.85,"existing_session_warnings":[]}]}\n' "$hosts" "$caller"
    elif [[ "$query" == *"this current worktree"* ]]; then
      printf '{"request":"fixture","host":"Milads-M3-2","fresh_only":true,"default_harness":"claude-gpt","default_model":"gpt-5.6-sol","registered_hosts":%s,"caller_context":%s,"candidates":[{"key":"ccs","host":"Milads-M3-2","current_host":"Milads-M3-2","name":"CCS","aliases":["session router"],"cwd":"/Users/mimen/Programming/Repos/claude-sessions","kind":"repo","eligible_hosts":["Milads-M3-2","Milads-Mac-mini"],"preferred_host":"Milads-Mac-mini","host_capabilities":["interactive-gui","local-user-state","browser-auth","shared-vault"],"default_harness":"claude-gpt","default_model":"gpt-5.6-sol","status":"active","host_eligible":true,"validation_error":null,"score":1,"existing_session_warnings":[]}]}\n' "$hosts" "$caller"
    else
      printf '{"request":"fixture","host":"Milads-M3-2","fresh_only":true,"default_harness":"claude-gpt","default_model":"gpt-5.6-sol","registered_hosts":%s,"caller_context":%s,"candidates":[]}\n' "$hosts" "$caller"
    fi
    ;;
  list)
    [[ $# -eq 0 ]] || usage
    printf '%s\n' '{"locations":[{"key":"ccs"},{"key":"events"},{"key":"auf-web"}]}'
    ;;
  launch)
    [[ "${1:-}" == "--session-id" && $# -ge 2 ]] || usage
    session_id="$2"
    shift 2
    prompt="$(read_prompt "$session_id")"
    host=""
    location=""
    cwd=""
    title=""
    model=""
    capabilities=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --host) host="$2"; shift 2 ;;
        --location) location="$2"; shift 2 ;;
        --cwd) cwd="$2"; shift 2 ;;
        --title) title="$2"; shift 2 ;;
        --model) model="$2"; shift 2 ;;
        --require-capability) capabilities+=("$2"); shift 2 ;;
        *) shift ;;
      esac
    done
    capability_text=" "
    if (( ${#capabilities[@]} > 0 )); then
      capability_text=" ${capabilities[*]} "
    fi
    if [[ "$host" == "Milads-Mac-mini" && "$location" == "ccs" ]]; then
      cat <<'JSON'
{"status":"workspace_created","session_id":"pending","title":"Remote session receipt confirmations","host":"Milads-Mac-mini","location":"ccs","cwd":"/Users/mimen1994/Programming/Repos/claude-sessions","harness":"claude-gpt","model":"gpt-5.6-sol","launch_model":"gpt-5.6-sol[1m]","workspace_ref":"workspace:fixture-mini","uncertainty":"Remote workspace creation succeeded, but session reservation and prompt delivery are not yet receipt-confirmed. Inspect this workspace before any retry."}
JSON
    elif [[ "$host" == "Milads-M3-2" && "$location" == "auf-web" && "$capability_text" == *" browser-auth "* && "$capability_text" == *" local-user-state "* ]]; then
      cat <<'JSON'
{"status":"launched","session_id":"11111111-1111-4111-8111-111111111111","title":"Fix checkout UI","host":"Milads-M3-2","location":"auf-web","cwd":"/Users/mimen/Programming/Repos/afternoonumbrellafriends.com","harness":"claude","model":"claude-fable-5","launch_model":"claude-fable-5","workspace_ref":"workspace:fixture-local","error":null}
JSON
    elif [[ "$host" == "Milads-M3-2" && "$cwd" == "/Users/mimen/Programming/Repos/claude-sessions/.claude/worktrees/ccs-new-router" && "$model" == "gpt-5.6-sol" && "$capability_text" == *" local-user-state "* ]]; then
      cat <<'JSON'
{"status":"launched","session_id":"22222222-2222-4222-8222-222222222222","title":"Continue receipt work","host":"Milads-M3-2","location":null,"cwd":"/Users/mimen/Programming/Repos/claude-sessions/.claude/worktrees/ccs-new-router","harness":"claude-gpt","model":"gpt-5.6-sol","launch_model":"gpt-5.6-sol[1m]","workspace_ref":"workspace:fixture-worktree","error":null}
JSON
    elif [[ "$host" == "Milads-M3-2" && "$cwd" == "/Users/mimen/Programming/Repos/ccs-new-eval-project" && "$model" == "gpt-5.6-sol" ]]; then
      cat <<'JSON'
{"status":"launched","session_id":"33333333-3333-4333-8333-333333333333","title":"Add README note","host":"Milads-M3-2","location":null,"cwd":"/Users/mimen/Programming/Repos/ccs-new-eval-project","harness":"claude-gpt","model":"gpt-5.6-sol","launch_model":"gpt-5.6-sol[1m]","workspace_ref":"workspace:fixture-explicit","error":null}
JSON
    else
      python3 - "$host" "$location" "$cwd" "$model" "$prompt" "$capability_text" <<'PY'
import json, sys
print(json.dumps({"status": "unexpected_fixture_launch", "host": sys.argv[1], "location": sys.argv[2] or None, "cwd": sys.argv[3] or None, "model": sys.argv[4] or None, "prompt": sys.argv[5], "capabilities": sys.argv[6].split()}))
PY
      exit 70
    fi
    ;;
  register)
    key="${1:-}"
    shift || true
    cwd=""
    eligible=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --cwd) cwd="$2"; shift 2 ;;
        --eligible-host) eligible="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    [[ "$key" == "ccs-new-eval-project" && "$cwd" == "/Users/mimen/Programming/Repos/ccs-new-eval-project" && "$eligible" == "Milads-M3-2" ]] || exit 70
    printf '%s\n' '{"status":"registered","key":"ccs-new-eval-project","cwd":"/Users/mimen/Programming/Repos/ccs-new-eval-project","eligible_hosts":["Milads-M3-2"]}'
    ;;
  cleanup)
    [[ "${1:-}" == "--session-id" && $# -eq 2 ]] || usage
    cleanup_prompt "$2"
    ;;
  *)
    usage
    ;;
esac
