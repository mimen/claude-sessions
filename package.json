{
  "name": "claude-sessions",
  "version": "0.1.0",
  "description": "A global TUI to find and resume any Claude Code session (ccs).",
  "type": "module",
  "bin": {
    "ccs": "bin/ccs"
  },
  "scripts": {
    "ccs": "./bin/ccs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/sidebar/web",
    "typecheck:web": "tsc --noEmit -p src/sidebar/web",
    "test": "bun test && bun run test:dom",
    "setup": "bun run scripts/setup.ts",
    "cmux:sidebar": "bun run scripts/cmux-sidebar.ts",
    "cmux:sidebar:install": "bun run scripts/cmux-sidebar.ts install",
    "cmux:sidebar:install:force": "bun run scripts/cmux-sidebar.ts install --force",
    "cmux:sidebar:install:web": "bun run scripts/cmux-sidebar.ts install-web",
    "cmux:sidebar:install:web:force": "bun run scripts/cmux-sidebar.ts install-web --force",
    "cmux:sidebar:validate": "bun run scripts/cmux-sidebar.ts validate",
    "cmux:sidebar:select": "bun run scripts/cmux-sidebar.ts select",
    "cmux:sidebar:open": "bun run scripts/cmux-sidebar.ts open",
    "benchmark:sidebar": "bun run scripts/sidebar-performance-benchmark.ts",
    "benchmark:sidebar:actions": "bun run scripts/sidebar-action-benchmark.ts",
    "ground-truth:sidebar": "bun run scripts/sidebar-ground-truth.ts",
    "report:detached-children": "bun run scripts/report-detached-children.ts",
    "report:detached-children:dossier": "bun run scripts/render-detached-child-dossier.ts",
    "lint:exports": "ts-prune -e",
    "lint:circular": "madge --circular --extensions ts,tsx src/",
    "test:dom": "bun test --preload ./src/sidebar/web/test-dom.ts src/sidebar/web/components/*.dom.test.tsx"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lobehub/icons-static-svg": "1.94.0",
    "@tailwindcss/cli": "~4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fuzzysort": "^3.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "smol-toml": "^1.6.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "~4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.11.2",
    "madge": "^8.0.0",
    "ts-prune": "^0.10.3",
    "typescript": "^5"
  }
}
