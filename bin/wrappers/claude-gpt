#!/bin/zsh -f
# claude-gpt — Claude Code on GPT-5.6 through the local CLIProxyAPI gateway. The launcher registry
# declares the exact 921K context window; GPT IDs must not carry Claude Code's false `[1m]` marker.
export CCS_FORCE_HARNESS=claude-gpt

model_base() {
  local value="${1//\[1m\]/}"
  value="${value%%\(*}"
  print -r -- "$value"
}

normalize_model() {
  print -r -- "${1//\[1m\]/}"
}

validate_model() {
  local base="$(model_base "$1")"
  case "$base" in
    gpt-5.6-*|opus|fable|sonnet|haiku|best|default) return 0 ;;
    gpt-5.5)
      print -u2 -- "claude-gpt: gpt-5.5 requires the 272K claude-gpt55 launcher"
      return 2
      ;;
    *)
      print -u2 -- "claude-gpt: model $base is outside this GPT-5.6 context envelope"
      return 2
      ;;
  esac
}

MODEL='fable'
args=("$@")
if (( ${#args} > 0 )) && [[ "${args[1]}" == gpt-* || "${args[1]}" == claude-* || "${args[1]}" == qwen* ]]; then
  validate_model "${args[1]}" || exit $?
  MODEL="$(normalize_model "${args[1]}")"
  args=("${args[@]:1}")
fi

for (( i = 1; i <= ${#args}; i++ )); do
  if [[ "${args[i]}" == "--model" ]] && (( i < ${#args} )); then
    next=$(( i + 1 ))
    validate_model "${args[$next]}" || exit $?
    args[$next]="$(normalize_model "${args[$next]}")"
    MODEL=""
    (( i++ ))
  elif [[ "${args[i]}" == --model=* ]]; then
    explicit="${args[i]#--model=}"
    validate_model "$explicit" || exit $?
    args[i]="--model=$(normalize_model "$explicit")"
    MODEL=""
  fi
done

margs=()
[[ -n "$MODEL" ]] && margs=(--model "$MODEL")
exec "${0:A:h}/claude" --dangerously-skip-permissions "${margs[@]}" "${args[@]}"
