#!/bin/zsh -f
# claude-gpt55 — Claude Code on GPT-5.5 through the local CLIProxyAPI gateway. The launcher registry
# declares the model's exact 272K context window.
export CCS_FORCE_HARNESS=claude-gpt55

normalize_model() {
  print -r -- "${1//\[1m\]/}"
}

validate_model() {
  local value="$(normalize_model "$1")"
  local base="${value%%\(*}"
  case "$base" in
    gpt-5.5|opus|fable|sonnet|haiku|best|default) return 0 ;;
    *)
      print -u2 -- "claude-gpt55: model $base is outside this GPT-5.5 context envelope"
      return 2
      ;;
  esac
}

MODEL='fable'
args=("$@")
if (( ${#args} > 0 )) && [[ "${args[1]}" == gpt-* || "${args[1]}" == claude-* || "${args[1]}" == qwen* ]]; then
  validate_model "${args[1]}" || exit $?
  MODEL="$(normalize_model "${args[1]}")"
  args=("${args[@]:1}")
fi

for (( i = 1; i <= ${#args}; i++ )); do
  if [[ "${args[i]}" == "--model" ]] && (( i < ${#args} )); then
    validate_model "${args[i + 1]}" || exit $?
    args[i + 1]="$(normalize_model "${args[i + 1]}")"
    MODEL=""
    (( i++ ))
  elif [[ "${args[i]}" == --model=* ]]; then
    explicit="${args[i]#--model=}"
    validate_model "$explicit" || exit $?
    args[i]="--model=$(normalize_model "$explicit")"
    MODEL=""
  fi
done

margs=()
[[ -n "$MODEL" ]] && margs=(--model "$MODEL")
exec "${0:A:h}/claude" --dangerously-skip-permissions "${margs[@]}" "${args[@]}"
