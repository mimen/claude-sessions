#!/bin/zsh -f
# claudex — one Claude Code harness for Claude 1M and GPT-5.6 921K models through the local
# CLIProxyAPI gateway. The launcher registry owns the gateway route, picker slots, and context env.
#
# Claude Code reads `[1m]` client-side for Claude IDs. GPT-5.6 must stay unsuffixed: its real 921K
# window comes from the launcher's CLAUDE_CODE_MAX_CONTEXT_TOKENS setting.
export CCS_FORCE_HARNESS=claudex

model_base() {
  local value="${1//\[1m\]/}"
  value="${value%%\(*}"
  print -r -- "$value"
}

validate_model() {
  local base="$(model_base "$1")"
  case "$base" in
    gpt-5.6-*|claude-*|grok-*|glm-*|opus|fable|sonnet|haiku|best|default|opusplan) return 0 ;;
    gpt-*|qwen*)
      print -u2 -- "claudex: model $base is outside this launcher's context envelope"
      return 2
      ;;
    *) return 0 ;;
  esac
}

declare_claude_window() {
  local canonical="${1//\[1m\]/}" base="$(model_base "$1")"
  case "$base" in
    claude-fable-*|claude-opus-*|claude-sonnet-*) print -r -- "${canonical}[1m]" ;;
    *) print -r -- "$canonical" ;;
  esac
}

MODEL='opus'
args=("$@")
if (( ${#args} > 0 )) && [[ "${args[1]}" == gpt-* || "${args[1]}" == claude-* || "${args[1]}" == grok-* || "${args[1]}" == glm-* || "${args[1]}" == qwen* ]]; then
  validate_model "${args[1]}" || exit $?
  MODEL="$(declare_claude_window "${args[1]}")"
  args=("${args[@]:1}")
fi

for (( i = 1; i <= ${#args}; i++ )); do
  if [[ "${args[i]}" == "--model" ]] && (( i < ${#args} )); then
    next=$(( i + 1 ))
    validate_model "${args[$next]}" || exit $?
    args[$next]="$(declare_claude_window "${args[$next]}")"
    MODEL=""
    (( i++ ))
  elif [[ "${args[i]}" == --model=* ]]; then
    explicit="${args[i]#--model=}"
    validate_model "$explicit" || exit $?
    args[i]="--model=$(declare_claude_window "$explicit")"
    MODEL=""
  fi
done

margs=()
[[ -n "$MODEL" ]] && margs=(--model "$MODEL")
exec "${0:A:h}/claude" --dangerously-skip-permissions "${margs[@]}" "${args[@]}"
