#!/bin/zsh -f
# claudex — one Claude Code harness for Claude 1M and GPT 921K-envelope models through the local
# CLIProxyAPI gateway. The launcher registry owns the gateway route, picker slots, and context env.
#
# Claude Code reads `[1m]` client-side for Claude IDs. GPT IDs stay unsuffixed: their window is the
# launcher's CLAUDE_CODE_MAX_CONTEXT_TOKENS envelope.
export CCS_FORCE_HARNESS=claudex

model_base() {
  local value="${1//\[1m\]/}"
  value="${value%%\(*}"
  print -r -- "$value"
}

# The models this launcher hosts come from the settings file `ccs launcher install` generates
# from the model registry, so adding a model is one registry edit and never a change here.
# Aliases Claude Code resolves itself pass through; a missing settings file lets Claude Code's
# own allowlist enforcement answer instead of guessing here.
validate_model() {
  local base="$(model_base "$1")"
  case "$base" in
    opus|fable|sonnet|haiku|best|default|opusplan) return 0 ;;
  esac
  local settings="${CCS_LAUNCHER_ENV_DIR:-$HOME/.ccs/launcher-env}/claudex.settings.json"
  [[ -r "$settings" ]] || return 0
  if grep -Fq -- "\"${base}\"" "$settings" || grep -Fq -- "\"${base}[1m]\"" "$settings"; then
    return 0
  fi
  print -u2 -- "claudex: model $base is not in this launcher's registry allowlist ($settings)"
  return 2
}

declare_claude_window() {
  local canonical="${1//\[1m\]/}" base="$(model_base "$1")"
  case "$base" in
    claude-fable-*|claude-opus-*|claude-sonnet-*) print -r -- "${canonical}[1m]" ;;
    *) print -r -- "$canonical" ;;
  esac
}

MODEL='opus'
EFFECTIVE_MODEL='opus'
args=("$@")
if (( ${#args} > 0 )) && [[ "${args[1]}" == *-* && "${args[1]}" != -* ]]; then
  validate_model "${args[1]}" || exit $?
  MODEL="$(declare_claude_window "${args[1]}")"
  EFFECTIVE_MODEL="$MODEL"
  args=("${args[@]:1}")
fi

for (( i = 1; i <= ${#args}; i++ )); do
  if [[ "${args[i]}" == "--model" ]] && (( i < ${#args} )); then
    next=$(( i + 1 ))
    validate_model "${args[$next]}" || exit $?
    args[$next]="$(declare_claude_window "${args[$next]}")"
    EFFECTIVE_MODEL="${args[$next]}"
    MODEL=""
    (( i++ ))
  elif [[ "${args[i]}" == --model=* ]]; then
    explicit="${args[i]#--model=}"
    validate_model "$explicit" || exit $?
    args[i]="--model=$(declare_claude_window "$explicit")"
    EFFECTIVE_MODEL="$explicit"
    MODEL=""
  fi
done

# Claude Code's built-in Artifact tool declares a JSON Schema `pattern` carrying Unicode property
# escapes (`\p{Cc}` and friends). OpenAI's and xAI's function-schema validators reject those
# outright, so every interactive request on a GPT or Grok lane 400s with
# "Invalid schema for function 'Artifact'". The tool is only sent in interactive sessions, which is
# why `-p` runs are unaffected. Dropping the tool at launch removes it from the wire schema, not
# just from execution. Claude lanes keep it. A mid-session `/model` switch from a Claude row to a
# GPT or Grok row keeps the launch decision and brings the error back; relaunch instead.
resolve_slot() {
  local spec="${CCS_LAUNCHER_ENV_DIR:-$HOME/.ccs/launcher-env}/claudex.env"
  [[ -r "$spec" ]] || return 1
  sed -n "s/^set ANTHROPIC_DEFAULT_${1}_MODEL=//p" "$spec" | tail -1
}

serves_artifacts() {
  local base="$(model_base "$1")"
  case "$base" in
    fable)             base="$(model_base "$(resolve_slot FABLE)")" ;;
    opus|opusplan)     base="$(model_base "$(resolve_slot OPUS)")" ;;
    sonnet)            base="$(model_base "$(resolve_slot SONNET)")" ;;
    haiku)             base="$(model_base "$(resolve_slot HAIKU)")" ;;
    best|default)      return 1 ;;
  esac
  [[ "$base" == claude-* || "$base" == anthropic.* ]]
}

targs=()
if ! serves_artifacts "$EFFECTIVE_MODEL" && [[ " ${args[*]} " != *" --disallowedTools "* ]]; then
  targs=(--disallowedTools Artifact)
fi

margs=()
[[ -n "$MODEL" ]] && margs=(--model "$MODEL")
exec "${0:A:h}/claude" --dangerously-skip-permissions "${margs[@]}" "${targs[@]}" "${args[@]}"
