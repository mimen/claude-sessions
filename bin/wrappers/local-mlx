#!/bin/zsh -f
# local-mlx — Claude Code on the local qwen3.8-local MLX model through CLIProxyAPI. The launcher
# registry declares the backend's exact 262,144-token context window.
export CCS_FORCE_HARNESS=local-mlx

normalize_model() {
  print -r -- "${1//\[1m\]/}"
}

validate_model() {
  local value="$(normalize_model "$1")"
  local base="${value%%\(*}"
  case "$base" in
    qwen3.8-local|opus|fable|sonnet|haiku|best|default) return 0 ;;
    *)
      print -u2 -- "local-mlx: model $base is outside this local context envelope"
      return 2
      ;;
  esac
}

MODEL='fable'
args=("$@")
if (( ${#args} > 0 )) && [[ "${args[1]}" == gpt-* || "${args[1]}" == claude-* || "${args[1]}" == qwen* ]]; then
  validate_model "${args[1]}" || exit $?
  MODEL="$(normalize_model "${args[1]}")"
  args=("${args[@]:1}")
fi

for (( i = 1; i <= ${#args}; i++ )); do
  if [[ "${args[i]}" == "--model" ]] && (( i < ${#args} )); then
    validate_model "${args[i + 1]}" || exit $?
    args[i + 1]="$(normalize_model "${args[i + 1]}")"
    MODEL=""
    (( i++ ))
  elif [[ "${args[i]}" == --model=* ]]; then
    explicit="${args[i]#--model=}"
    validate_model "$explicit" || exit $?
    args[i]="--model=$(normalize_model "$explicit")"
    MODEL=""
  fi
done

margs=()
[[ -n "$MODEL" ]] && margs=(--model "$MODEL")
exec "${0:A:h}/claude" --dangerously-skip-permissions "${margs[@]}" "${args[@]}"
